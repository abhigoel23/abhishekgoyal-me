{
  "name": "abhishekgoyal-me",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/resume-pdf.mjs",
    "preview": "wrangler dev",
    "check": "pnpm --silent cf:types && eslint . && prettier --check . && astro check --minimalOutput",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "pnpm --silent cf:types && astro check --minimalOutput",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lighthouse": "node scripts/lighthouse.mjs",
    "cf:types": "wrangler types --env-file .dev.vars.example > /dev/null",
    "deploy": "pnpm build && wrangler deploy",
    "astro": "astro",
    "resume": "node scripts/resume-pdf.mjs --private",
    "icons": "node scripts/build-icons.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.2",
    "@astrojs/markdown-satteri": "^0.4.1",
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/react": "^6.0.6",
    "@astrojs/sitemap": "^3.7.4",
    "@hookform/resolvers": "^5.9.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.3.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.135.0",
    "zod": "^4.6.5"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lighthouse": "^13.5.0",
    "lint-staged": "^17.5.1",
    "opentype.js": "^2.0.0",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^1.0.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "satori": "^0.33.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  },
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "lint-staged": {
    "*.{js,mjs,ts,tsx,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,mdx,css,html,yml,yaml,jsonc}": "prettier --write"
  }
}
