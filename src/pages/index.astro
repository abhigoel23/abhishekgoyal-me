---
import { getCollection } from 'astro:content';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import Container from '../components/Container.astro';
import Hero from '../components/Hero.astro';
import ProofStrip from '../components/ProofStrip.astro';
import Section from '../components/Section.astro';
import { primaryCta } from '../data/nav';
import { pages } from '../data/pages';
import { listedServices } from '../data/services';
import { writingCopy } from '../data/writing';
import Base from '../layouts/Base.astro';
import { formatPostDate, getPosts } from '../lib/posts';

const featured = (await getCollection('work', ({ data }) => data.featured)).sort(
  (a, b) => a.data.order - b.data.order,
);
const latestPosts = (await getPosts()).slice(0, 3);
---

<Base {...pages['/']}>
  <Container class="py-16 sm:py-24">
    <Hero />
    <div class="mt-16 sm:mt-20">
      <ProofStrip />
    </div>
  </Container>

  <Section id="work" eyebrow="Selected work" title="Case studies">
    <ul class="grid gap-6 md:grid-cols-3">
      {featured.map((entry) => (
        <li>
          <Card
            eyebrow={`${entry.data.role} · ${entry.data.period}`}
            title={entry.data.title}
            summary={entry.data.summary}
            tags={entry.data.stack.slice(0, 4)}
            href={`/work/${entry.id}`}
          />
        </li>
      ))}
    </ul>
    <p class="mt-8">
      <a class="link font-medium" href="/work">
        All case studies →
      </a>
    </p>
  </Section>

  <Section
    id="services"
    eyebrow="Services"
    title="How I can help"
    intro="For founders and product teams who need a mobile app built, rescued or moved to shared code."
    tone="surface"
  >
    <ul class="grid gap-x-10 gap-y-8 sm:grid-cols-2">
      {listedServices.map((service) => (
        <li>
          <h3 class="text-h3">
            <a class="hover:text-accent" href={`/services#${service.id}`}>
              {service.title}
            </a>
          </h3>
          <p class="mt-2 text-muted">{service.summary}</p>
        </li>
      ))}
    </ul>
    <p class="mt-10">
      <a class="link font-medium" href="/services">
        Services, process and FAQ →
      </a>
    </p>
  </Section>

  {latestPosts.length > 0 && (
    <Section id="writing" eyebrow={writingCopy.home.eyebrow} title={writingCopy.home.title}>
      <ul class="grid gap-6 md:grid-cols-3">
        {latestPosts.map((post) => (
          <li>
            <Card
              eyebrow={formatPostDate(post.data.pubDate)}
              title={post.data.title}
              summary={post.data.description}
              href={`/writing/${post.id}`}
              footerLabel={writingCopy.home.cardLink}
            />
          </li>
        ))}
      </ul>
      <p class="mt-8">
        <a class="link font-medium" href={writingCopy.home.link.href}>
          {writingCopy.home.link.label}
        </a>
      </p>
    </Section>
  )}

  <Container class="py-16 sm:py-24">
    <div class="rounded-brand border border-line px-6 py-12 text-center sm:px-12">
      <h2 class="text-h2">Have an app to build or fix?</h2>
      <p class="mx-auto mt-3 max-w-xl text-muted">
        Tell me what exists today and what you need by when.
      </p>
      <div class="mt-8">
        <Button href={primaryCta.href} size="lg">
          {primaryCta.label}
        </Button>
      </div>
    </div>
  </Container>
</Base>
