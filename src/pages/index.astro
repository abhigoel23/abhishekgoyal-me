---
// Home page, in the order a B2B buyer checks (ADR 007): proof, outcomes, terms, process, credentials.
import { getCollection } from 'astro:content';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import Container from '../components/Container.astro';
import Hero from '../components/Hero.astro';
import ProofStrip from '../components/ProofStrip.astro';
import Section from '../components/Section.astro';
import WorkFeature from '../components/WorkFeature.astro';
import { homeCopy, ndaOutcomes } from '../data/home';
import { bookCall } from '../data/lead';
import { primaryCta } from '../data/nav';
import { pages } from '../data/pages';
import { profile } from '../data/profile';
import { engagements, process } from '../data/services';
import { writingCopy } from '../data/writing';
import Base from '../layouts/Base.astro';
import { formatPostDate, getPosts } from '../lib/posts';

// Client case studies, flagship first (Pulse). Own products and prototypes are on /work.
const clientWork = (
  await getCollection('work', ({ data }) => data.featured && data.kind === 'client')
).sort((a, b) => a.data.order - b.data.order);
const latestPosts = (await getPosts()).slice(0, 3);
const credentials = profile.credentials.map((title, i) => ({
  title,
  note: homeCopy.credentials.notes[i],
}));
---

<Base {...pages['/']}>
  <Container class="py-16 sm:py-24">
    <Hero />
    <div class="mt-16 sm:mt-20">
      <ProofStrip />
    </div>
  </Container>

  <Section id="work" eyebrow={homeCopy.work.eyebrow} title={homeCopy.work.title}>
    <ul class="grid gap-6">
      {clientWork.map((entry, i) => (
        <li>
          <WorkFeature entry={entry} label={i === 0 ? homeCopy.work.flagship : undefined} />
        </li>
      ))}
    </ul>

    <div class="mt-16">
      <p class="eyebrow mb-3">{homeCopy.outcomes.eyebrow}</p>
      <h3 id="outcomes-title" class="text-h3">
        {homeCopy.outcomes.title}
      </h3>
      <p class="mt-2 text-muted">{homeCopy.outcomes.intro}</p>
      <ul class="mt-6 grid gap-6 md:grid-cols-2" aria-labelledby="outcomes-title">
        {ndaOutcomes.map((item) => (
          <li class="flex flex-col rounded-brand border border-line bg-surface p-6">
            <p class="eyebrow">
              {item.role} · {item.domain} · {item.period}
            </p>
            <p class="mt-4">
              <span class="font-display text-h2">{item.value}</span>
              <span class="ml-2 text-muted">{item.valueLabel}</span>
            </p>
            <p class="mt-3 text-muted">{item.outcome}</p>
          </li>
        ))}
      </ul>
    </div>

    <p class="mt-10">
      <a class="link font-medium" href="/work">
        {homeCopy.work.link}
      </a>
    </p>
  </Section>

  <Section
    id="engagements"
    eyebrow={homeCopy.engagements.eyebrow}
    title={homeCopy.engagements.title}
    intro={homeCopy.engagements.intro}
    tone="surface"
  >
    <table class="w-full max-w-4xl border-collapse text-left">
      <thead class="sr-only sm:not-sr-only">
        <tr class="border-b border-ink/80">
          <th scope="col" class="eyebrow py-3 pr-8 font-semibold">
            {homeCopy.engagements.columns.model}
          </th>
          <th scope="col" class="eyebrow py-3 font-semibold">
            {homeCopy.engagements.columns.terms}
          </th>
        </tr>
      </thead>
      <tbody>
        {engagements.map((engagement) => (
          <tr class="border-b border-line max-sm:flex max-sm:flex-col max-sm:py-4">
            <th scope="row" class="py-0 pr-8 align-top font-medium sm:w-1/3 sm:py-5">
              {engagement.title}
              {engagement.recommended && (
                <span class="ml-2 text-xs font-medium tracking-wide text-accent uppercase">
                  {homeCopy.engagements.recommended}
                </span>
              )}
            </th>
            <td class="pt-1 align-top text-muted sm:py-5">{engagement.body}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="mt-8">
      <a class="link font-medium" href="/services">
        {homeCopy.engagements.link}
      </a>
    </p>
  </Section>

  <Section id="process" eyebrow={homeCopy.process.eyebrow} title={homeCopy.process.title}>
    <ol class="grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
      {process.map((step, i) => (
        <li class="border-t border-ink/80 pt-5">
          <p class="font-mono text-sm text-accent">{String(i + 1).padStart(2, '0')}</p>
          <h3 class="mt-3 text-h3">{step.title}</h3>
          <p class="mt-2 text-muted">{step.body}</p>
        </li>
      ))}
    </ol>
  </Section>

  <Section
    id="credentials"
    eyebrow={homeCopy.credentials.eyebrow}
    title={homeCopy.credentials.title}
  >
    <dl class="grid max-w-4xl gap-6 sm:grid-cols-3">
      {credentials.map((item) => (
        <div class="border-l border-accent pl-4">
          <dt class="font-medium">{item.title}</dt>
          <dd class="mt-1 text-sm text-muted">{item.note}</dd>
        </div>
      ))}
    </dl>
  </Section>

  {latestPosts.length > 0 && (
    <Section id="writing" eyebrow={writingCopy.home.eyebrow} title={writingCopy.home.title}>
      <ul class="grid gap-6 md:grid-cols-3">
        {latestPosts.map((post) => (
          <li>
            <Card
              eyebrow={formatPostDate(post.data.pubDate)}
              title={post.data.title}
              summary={post.data.description}
              href={`/writing/${post.id}`}
              footerLabel={writingCopy.home.cardLink}
            />
          </li>
        ))}
      </ul>
      <p class="mt-8">
        <a class="link font-medium" href={writingCopy.home.link.href}>
          {writingCopy.home.link.label}
        </a>
      </p>
    </Section>
  )}

  <Container class="py-16 sm:py-24">
    <div class="rounded-brand border border-line bg-surface px-6 py-12 sm:px-12">
      <h2 class="text-h2 max-w-2xl">{homeCopy.closing.title}</h2>
      <p class="mt-3 max-w-xl text-muted">{homeCopy.closing.body}</p>
      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
        <Button href={primaryCta.href} size="lg">
          {primaryCta.label}
        </Button>
        <a
          class="link text-sm font-medium"
          href={bookCall.href}
          target="_blank"
          rel="noopener noreferrer"
          data-cta="book_call"
        >
          {bookCall.label} <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </Container>
</Base>
