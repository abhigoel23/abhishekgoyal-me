---
// The resume as a page. scripts/resume-pdf.mjs prints it to /resume.pdf at build (and a private copy with a
// phone number via `pnpm resume`), so the web page and PDF always match. It stays one A4 page: the build fails otherwise.
import { Font } from 'astro:assets';
import SEO from '../components/SEO.astro';
import { career, education } from '../data/career';
import { pages } from '../data/pages';
import { profile } from '../data/profile';
import { coreStack, resumeSummary } from '../data/resume';
import { richText } from '../lib/richText';
import { light } from '../lib/theme';

const bare = (url: string) => url.replace(/^https:\/\/(www\.)?/, '');

// The private PDF (`pnpm resume`) fills [data-phone] with " · <phone>"; the public page and PDF never contain it.
type ContactItem = { text: string; href?: string; phone?: boolean };
const contactLines: ContactItem[][] = [
  [
    { text: `${profile.location.city}, ${profile.location.country}`, phone: true },
    { text: profile.email, href: `mailto:${profile.email}` },
    { text: bare(profile.url), href: profile.url },
    { text: bare(profile.links.github), href: profile.links.github },
  ],
  [
    { text: bare(profile.links.linkedin), href: profile.links.linkedin },
    { text: `HelperBook: ${bare(profile.links.helperbook)}`, href: profile.links.helperbook },
  ],
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEO {...pages['/resume']} type="profile" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Font cssVariable="--font-inter" preload />
  </head>
  <body>
    <nav class="toolbar" aria-label="Resume">
      <a href="/">← {bare(profile.url)}</a>
      <a class="primary" href="/resume.pdf" download="Abhishek-Goyal-Resume.pdf">
        Download PDF
      </a>
    </nav>

    <main class="sheet">
      <header>
        <h1>{profile.name}</h1>
        <p class="headline">{profile.headline}</p>
        <p class="contact">
          {contactLines.map((line, i) => (
            <>
              {i > 0 && <br />}
              {line.map((item, j) => (
                <>
                  {j > 0 && ' · '}
                  {item.href ? <a href={item.href}>{item.text}</a> : item.text}
                  {item.phone && <span data-phone />}
                </>
              ))}
            </>
          ))}
        </p>
      </header>

      <h2>Summary</h2>
      <p set:html={richText(resumeSummary)} />

      <h2>Core stack</h2>
      <dl class="stack">
        {coreStack.map((row) => (
          <>
            <dt>{row.label}</dt>
            <dd>{row.items}</dd>
          </>
        ))}
      </dl>

      <h2>Experience</h2>
      {career.map((job) => (
        <section class="job">
          <div class="job-head">
            <h3>
              {job.role} — {job.company}
            </h3>
            <span class="job-meta">
              {[job.period, job.location, job.note].filter(Boolean).join(' · ')}
            </span>
          </div>
          {job.subtitle && <p class="job-sub">{job.subtitle}</p>}
          <ul>
            {job.highlights.map((highlight) => (
              <li set:html={richText(highlight)} />
            ))}
          </ul>
        </section>
      ))}

      <h2>Education</h2>
      <p>
        <strong>{education.degree}</strong> — {education.school}
      </p>
    </main>
  </body>
</html>

<style
  define:vars={{
    ink: light.ink,
    accent: light.accent,
    muted: light.muted,
    line: light.line,
    bg: light.bg,
  }}
>
  @page {
    size: A4;
    margin: 9mm 12mm 8mm;
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    font-family: var(--font-inter), 'Helvetica Neue', Arial, sans-serif;
    font-size: 8.6pt;
    line-height: 1.32;
    color: var(--ink);
    background: var(--bg);
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  h1 {
    margin: 0;
    font-size: 20pt;
    letter-spacing: -0.01em;
  }
  .headline {
    margin: 2pt 0 3pt;
    font-weight: 600;
    color: var(--accent);
    font-size: 9.8pt;
  }
  .contact {
    color: var(--muted);
  }
  h2 {
    margin: 7pt 0 3pt;
    padding-bottom: 2pt;
    border-bottom: 0.75pt solid var(--line);
    font-size: 9.4pt;
    text-transform: uppercase;
    letter-spacing: 0; /* normal spacing keeps headings intact for ATS parsers */
    color: var(--accent);
  }
  p {
    margin: 0;
  }
  .stack {
    display: grid;
    grid-template-columns: 26mm 1fr;
    gap: 1pt 6pt;
    margin: 0;
  }
  .stack dt {
    font-weight: 600;
  }
  .stack dd {
    margin: 0;
  }
  .job {
    margin-top: 5pt;
    break-inside: avoid;
  }
  .job-head {
    display: flex;
    justify-content: space-between;
    gap: 8pt;
  }
  .job-head h3 {
    margin: 0;
    font-size: inherit;
    font-weight: 700;
  }
  .job-meta {
    color: var(--muted);
    white-space: nowrap;
  }
  .job-sub {
    color: var(--muted);
    margin-top: 1pt;
  }
  ul {
    margin: 2pt 0 0;
    padding-left: 11pt;
  }
  li {
    margin: 0.8pt 0;
  }
  li :global(strong) {
    font-weight: 600;
  }

  /* On screen: an A4 sheet with a toolbar. In print (and the PDF) only the sheet remains. */
  @media screen {
    body {
      padding: 16px;
    }
    .sheet {
      max-width: 210mm;
      margin: 0 auto;
      padding: 9mm 12mm 8mm;
      background: #fff;
      border: 1px solid var(--line);
      box-shadow: 0 8px 30px rgb(0 0 0 / 0.06);
    }
    .toolbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      max-width: 210mm;
      margin: 0 auto 16px;
      font-size: 14px;
    }
    .toolbar a {
      color: var(--accent);
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    .toolbar a.primary {
      padding: 10px 16px;
      border-radius: 4px;
      background: var(--accent);
      color: #fff;
      text-decoration: none;
    }
    .toolbar a:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 3px;
    }
  }
  @media screen and (max-width: 640px) {
    .sheet {
      padding: 16px;
      font-size: 10pt;
    }
    /* Dates, place and note stay on one line in the PDF, but must wrap on a small phone. */
    .job-meta {
      white-space: normal;
    }
    .job-head {
      flex-direction: column;
      gap: 0;
    }
    .stack {
      grid-template-columns: 1fr;
    }
    .stack dd {
      margin-bottom: 4pt;
    }
  }
  @media print {
    body {
      background: #fff;
    }
    .toolbar {
      display: none;
    }
  }
</style>
