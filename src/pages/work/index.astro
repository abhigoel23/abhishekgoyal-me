---
import { getCollection } from 'astro:content';
import Card from '../../components/Card.astro';
import Container from '../../components/Container.astro';
import { pages } from '../../data/pages';
import Base from '../../layouts/Base.astro';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---

<Base {...pages['/work']}>
  <Container class="py-16 sm:py-24">
    <p class="eyebrow mb-3">Case studies</p>
    <h1 class="text-h1 max-w-3xl">Mobile products, taken from zero to shipped</h1>
    <p class="mt-5 max-w-2xl text-lead text-muted">
      Three projects where I owned the mobile side end to end: architecture, the app itself and the
      release.
    </p>
    <ul class="mt-14 grid gap-6 md:grid-cols-3">
      {work.map((entry) => (
        <li>
          <Card
            eyebrow={`${entry.data.role} · ${entry.data.period}`}
            title={entry.data.title}
            summary={entry.data.summary}
            tags={entry.data.stack.slice(0, 4)}
            href={`/work/${entry.id}`}
            headingLevel="h2"
          />
        </li>
      ))}
    </ul>
  </Container>
</Base>
