---
// Landing page for the checklist lead magnet. Not live yet: the real sign-up form arrives in #111, so
// this page stays noindex and out of the sitemap (astro.config.mjs) and isn't linked from nav/footer/home.
import Container from '../../components/Container.astro';
import { checklist, checklistPage } from '../../data/checklist';
import { pages } from '../../data/pages';
import Base from '../../layouts/Base.astro';
---

<Base {...pages['/checklist']} noindex>
  <Container class="py-16 sm:py-24">
    <div class="grid gap-12 md:grid-cols-[1.5fr_1fr] md:gap-16">
      <div>
        <p class="eyebrow mb-3">{checklistPage.eyebrow}</p>
        <h1 class="text-h1 max-w-2xl">{checklistPage.title}</h1>
        <p class="mt-5 max-w-2xl text-lead text-muted">{checklistPage.lead}</p>

        <h2 class="text-h3 mt-10">Who it's for</h2>
        <ul class="mt-4 space-y-2 text-muted">
          {checklistPage.whoFor.map((line) => (
            <li class="flex gap-3">
              <span aria-hidden="true" class="text-accent">
                →
              </span>
              <span>{line}</span>
            </li>
          ))}
        </ul>

        <h2 class="text-h3 mt-10">What's inside</h2>
        <ul class="mt-4 space-y-2 text-muted">
          {checklistPage.inside.map((line) => (
            <li class="flex gap-3">
              <span aria-hidden="true" class="text-accent">
                →
              </span>
              <span>{line}</span>
            </li>
          ))}
        </ul>

        <h2 class="text-h3 mt-10">The sections</h2>
        <ul class="mt-4 grid gap-3 sm:grid-cols-2">
          {checklist.sections.map((section) => {
            const count: number = section.items.length;
            return (
              <li class="rounded-brand border border-line px-4 py-3">
                <p class="font-medium text-ink">{section.title}</p>
                <p class="mt-1 text-sm text-muted">
                  {count} item{count === 1 ? '' : 's'}
                </p>
              </li>
            );
          })}
        </ul>
      </div>

      <div
        id="checklist-signup"
        data-signup-slot
        class="h-fit rounded-brand border border-line bg-surface p-6"
      >
        <p class="text-h3">Get the checklist</p>
        <p class="mt-3 text-muted">{checklistPage.formNote}</p>
        <p class="mt-4 text-sm font-medium text-accent">{checklistPage.soon}</p>
      </div>
    </div>
  </Container>
</Base>
