---
// The checklist PDF source. scripts/checklist-pdf.mjs prints this page to the public PDF at build, so the
// web page and PDF always match. Light theme only, like /resume: kept simple and readable in print.
// Not live yet (#111 ships the sign-up form): noindex and excluded from the sitemap.
import { Font } from 'astro:assets';
import SEO from '../../components/SEO.astro';
import { checklist } from '../../data/checklist';
import { pages } from '../../data/pages';
import { profile } from '../../data/profile';
import { richText } from '../../lib/richText';
import { light } from '../../lib/theme';

const closingParts = checklist.closing.split('/contact');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEO {...pages['/checklist/print']} noindex />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Font cssVariable="--font-inter" preload />
  </head>
  <body>
    <nav class="toolbar" aria-label="Checklist">
      <a href="/checklist">← Back to the checklist page</a>
    </nav>

    <main class="sheet">
      <header>
        <h1>{checklist.title}</h1>
        <p class="subtitle">{checklist.subtitle}</p>
        <p class="meta">
          {checklist.version} · {profile.name} · abhishekgoyal.me
        </p>
      </header>

      {checklist.intro.map((paragraph) => (
        <p class="intro">{paragraph}</p>
      ))}

      {checklist.sections.map((section) => (
        <section class="section">
          <h2>{section.title}</h2>
          <ol>
            {section.items.map((item) => (
              <li>
                <span aria-hidden="true" class="box"></span>
                <span class="item-text">
                  <span set:html={richText(item.text)} />
                  {'why' in item && <span class="why">{item.why}</span>}
                </span>
              </li>
            ))}
          </ol>
        </section>
      ))}

      <p class="closing">
        {closingParts[0]}
        <a href={`${profile.url}/contact`}>{`${profile.url}/contact`}</a>
        {closingParts[1]}
      </p>

      <p class="footer">{profile.url}</p>
    </main>
  </body>
</html>

<style
  define:vars={{
    ink: light.ink,
    accent: light.accent,
    muted: light.muted,
    line: light.line,
    bg: light.bg,
  }}
>
  @page {
    size: A4;
    margin: 14mm 16mm 14mm;
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    font-family: var(--font-inter), 'Helvetica Neue', Arial, sans-serif;
    font-size: 10pt;
    line-height: 1.45;
    color: var(--ink);
    background: var(--bg);
  }
  a {
    color: var(--accent);
  }
  h1 {
    margin: 0;
    font-size: 22pt;
    letter-spacing: -0.01em;
  }
  .subtitle {
    margin: 6pt 0 4pt;
    color: var(--muted);
    max-width: 46em;
  }
  .meta {
    margin: 0;
    font-size: 9pt;
    font-weight: 600;
    color: var(--accent);
  }
  .intro {
    margin: 10pt 0 0;
    max-width: 46em;
  }
  /* Sections flow across pages; a heading never ends a page, and an item never splits. */
  .section {
    margin-top: 16pt;
  }
  h2 {
    break-after: avoid-page;
    margin: 0 0 6pt;
    padding-bottom: 3pt;
    border-bottom: 1pt solid var(--line);
    font-size: 12pt;
    color: var(--accent);
  }
  ol {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: item;
  }
  li {
    display: flex;
    gap: 8pt;
    align-items: flex-start;
    margin: 7pt 0;
    break-inside: avoid;
  }
  .box {
    flex: none;
    width: 9pt;
    height: 9pt;
    margin-top: 2pt;
    border: 1pt solid var(--ink);
    border-radius: 1.5pt;
  }
  .item-text {
    display: block;
  }
  .why {
    display: block;
    margin-top: 2pt;
    font-size: 8.6pt;
    color: var(--muted);
  }
  .closing {
    margin-top: 18pt;
    padding-top: 10pt;
    border-top: 1pt solid var(--line);
    max-width: 46em;
  }
  .footer {
    margin-top: 10pt;
    font-size: 8.6pt;
    color: var(--muted);
  }

  /* On screen: a sheet like the resume page. In print (and the PDF) only the sheet remains. */
  @media screen {
    body {
      padding: 16px;
    }
    .sheet {
      max-width: 210mm;
      margin: 0 auto;
      padding: 14mm 16mm;
      background: #fff;
      border: 1px solid var(--line);
      box-shadow: 0 8px 30px rgb(0 0 0 / 0.06);
    }
    .toolbar {
      max-width: 210mm;
      margin: 0 auto 16px;
      font-size: 14px;
    }
    .toolbar a {
      color: var(--accent);
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    .toolbar a:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 3px;
    }
  }
  @media screen and (max-width: 640px) {
    .sheet {
      padding: 20px;
    }
  }
  @media print {
    body {
      background: #fff;
    }
    .toolbar {
      display: none;
    }
  }
</style>
