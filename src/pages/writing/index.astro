---
import Container from '../../components/Container.astro';
import Tag from '../../components/Tag.astro';
import { writingCopy } from '../../data/writing';
import { pages } from '../../data/pages';
import Base from '../../layouts/Base.astro';
import { formatPostDate, getPosts } from '../../lib/posts';
import { readingTime } from '../../lib/readingTime';

const posts = await getPosts();
const minutes = posts.map((post) => readingTime(post.body ?? ''));
---

<Base {...pages['/writing']}>
  <Container class="py-16 sm:py-24">
    <p class="eyebrow mb-3">Writing</p>
    <h1 class="text-h1 max-w-3xl">Notes from building mobile products</h1>
    <p class="mt-5 max-w-2xl text-lead text-muted">{writingCopy.intro}</p>

    {posts.length === 0 ? (
      <div class="mt-14 max-w-xl rounded-brand border border-line bg-surface p-8">
        <h2 class="text-h3">{writingCopy.empty.title}</h2>
        <p class="mt-3 text-muted">{writingCopy.empty.body}</p>
        <p class="mt-5">
          <a class="link" href={writingCopy.empty.link.href}>
            {writingCopy.empty.link.label}
          </a>
        </p>
      </div>
    ) : (
      <ul class="mt-14 flex flex-col gap-8">
        {posts.map((post, i) => (
          <li class="border-b border-line pb-8 last:border-b-0">
            <a href={`/writing/${post.id}`} class="group block">
              <p class="eyebrow mb-2 flex flex-wrap items-center gap-x-2 gap-y-1">
                <time datetime={post.data.pubDate.toISOString()}>
                  {formatPostDate(post.data.pubDate)}
                </time>
                <span aria-hidden="true">·</span>
                <span>{minutes[i]} min read</span>
              </p>
              <h2 class="text-h3 group-hover:text-accent">{post.data.title}</h2>
              <p class="mt-3 text-muted">{post.data.description}</p>
            </a>
            {post.data.tags.length > 0 && (
              <ul class="mt-4 flex flex-wrap gap-2" aria-label="Tags">
                {post.data.tags.map((tag) => (
                  <li>
                    <Tag>{tag}</Tag>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    )}
  </Container>
</Base>
