---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Button from '../../components/Button.astro';
import Container from '../../components/Container.astro';
import Tag from '../../components/Tag.astro';
import { primaryCta } from '../../data/nav';
import Base from '../../layouts/Base.astro';
import { formatPostDate, isPublished } from '../../lib/posts';
import { readingTime } from '../../lib/readingTime';
import { SITE_URL, blogPostingJsonLd, canonicalUrl, ogImagePath } from '../../lib/seo';

export async function getStaticPaths() {
  const posts = await getCollection('writing', ({ data }) =>
    isPublished(data, import.meta.env.PROD),
  );
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

type Props = { entry: CollectionEntry<'writing'> };
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const pageUrl = canonicalUrl(`/writing/${entry.id}`);
// Only differs from pageUrl when the post first ran elsewhere.
const canonical = d.canonicalUrl ?? pageUrl;
const imageUrl = new URL(ogImagePath('/writing'), SITE_URL).href;
const minutes = readingTime(entry.body ?? '');

const blogJsonLd = blogPostingJsonLd({
  title: d.title,
  description: d.description,
  pubDate: d.pubDate,
  updatedDate: d.updatedDate,
  tags: d.tags,
  image: imageUrl,
  url: pageUrl,
});
---

<Base
  title={d.title}
  description={d.description}
  type="article"
  image={imageUrl}
  canonical={canonical}
  jsonLd={[blogJsonLd]}
>
  <Container class="pt-12 sm:pt-16">
    <p class="text-sm">
      <a class="link" href="/writing">
        ← All writing
      </a>
    </p>
    <p class="eyebrow mt-10 mb-3 flex flex-wrap items-center gap-x-2 gap-y-1">
      <time datetime={d.pubDate.toISOString()}>{formatPostDate(d.pubDate)}</time>
      {d.updatedDate && (
        <>
          <span aria-hidden="true">·</span>
          <span>Updated {formatPostDate(d.updatedDate)}</span>
        </>
      )}
      <span aria-hidden="true">·</span>
      <span>{minutes} min read</span>
    </p>
    <h1 class="text-h1 max-w-3xl">{d.title}</h1>
    <p class="mt-5 max-w-2xl text-lead text-muted">{d.description}</p>
    {d.tags.length > 0 && (
      <ul class="mt-6 flex flex-wrap gap-2" aria-label="Tags">
        {d.tags.map((tag) => (
          <li>
            <Tag>{tag}</Tag>
          </li>
        ))}
      </ul>
    )}
  </Container>

  {d.heroImage && (
    <Container class="pt-10 sm:pt-14">
      <Image
        src={d.heroImage}
        alt={d.heroAlt ?? ''}
        widths={[480, 768, 1200]}
        sizes="(min-width: 1024px) 900px, 100vw"
        class="h-auto w-full rounded-[1.25rem] border border-line"
      />
    </Container>
  )}

  <Container class="py-12 sm:py-16">
    <article class="prose">
      <Content />
    </article>
  </Container>

  <Container class="py-16 sm:py-20">
    <div class="flex flex-col gap-8 border-t border-line pt-10 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="eyebrow mb-2">Read more</p>
        <a href="/writing" class="font-display text-h2 hover:text-accent">
          All writing →
        </a>
      </div>
      <Button href={primaryCta.href} size="lg">
        {primaryCta.label}
      </Button>
    </div>
  </Container>
</Base>
