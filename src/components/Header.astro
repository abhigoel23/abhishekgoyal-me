---
import { nav, primaryCta } from '../data/nav';
import { profile } from '../data/profile';
import Button from './Button.astro';
import Container from './Container.astro';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
---

<header class="border-b border-line">
  <Container class="flex h-18 items-center justify-between gap-4">
    <a href="/" class="font-display text-xl whitespace-nowrap">
      {profile.name}
    </a>
    <nav aria-label="Primary" class="hidden md:block">
      <ul class="flex items-center gap-7 text-sm">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={path.startsWith(item.href) ? 'page' : undefined}
              class="text-muted hover:text-ink aria-[current=page]:text-ink"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="flex items-center gap-1">
      <ThemeToggle />
      <div class="ml-2 hidden sm:block">
        <Button href={primaryCta.href}>{primaryCta.label}</Button>
      </div>
      <details class="group relative md:hidden">
        <summary class="flex size-11 cursor-pointer list-none items-center justify-center rounded-full hover:bg-surface [&::-webkit-details-marker]:hidden">
          <span class="sr-only">Menu</span>
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            class="size-5"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
          >
            <path d="M4 7h16M4 12h16M4 17h16" class="group-open:hidden"></path>
            <path d="M6 6l12 12M18 6 6 18" class="hidden group-open:block"></path>
          </svg>
        </summary>
        <nav
          aria-label="Primary"
          class="absolute right-0 z-10 mt-2 w-56 rounded-brand border border-line bg-bg p-2 shadow-lg"
        >
          <ul>
            {[...nav, primaryCta].map((item) => (
              <li>
                <a href={item.href} class="block rounded-brand px-3 py-2.5 hover:bg-surface">
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </details>
    </div>
  </Container>
</header>
