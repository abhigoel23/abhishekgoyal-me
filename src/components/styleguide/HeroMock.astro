---
// The home-page hero with real copy, as a specimen until M2 builds the real one.
import { hireCta, primaryCta } from '../../data/nav';
import { profile } from '../../data/profile';
import Button from '../Button.astro';
---

<div class="grid items-center gap-10 md:grid-cols-[1.5fr_1fr] md:gap-16">
  <div>
    <p class="eyebrow mb-5">{profile.pillars.join(' · ')}</p>
    <h2 class="text-display text-ink">{profile.positioning}</h2>
    <p class="mt-6 max-w-xl text-lead text-muted">{profile.intro}</p>
    <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
      <Button href={primaryCta.href} size="lg">
        {primaryCta.label}
      </Button>
      <a href={hireCta.href} class="link text-sm font-medium">
        {hireCta.label} →
      </a>
    </div>
  </div>
  <div
    class="relative mx-auto aspect-[4/5] w-full max-w-xs overflow-hidden rounded-brand border border-line bg-surface"
    role="img"
    aria-label="Photo placeholder"
  >
    <span class="font-display absolute inset-0 grid place-items-center text-[5rem] text-muted/60">
      AG
    </span>
    <span class="eyebrow absolute bottom-4 left-4">Photo in M2</span>
  </div>
</div>
