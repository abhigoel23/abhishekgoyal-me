---
// Flips between light and dark and remembers the choice. The pre-paint script in Base.astro applies it on load.
---

<button
  type="button"
  data-theme-toggle
  class="inline-flex size-11 items-center justify-center rounded-full text-ink hover:bg-surface"
  aria-label="Switch to dark theme"
>
  <svg
    aria-hidden="true"
    viewBox="0 0 24 24"
    class="size-5"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
  >
    <circle cx="12" cy="12" r="4.5"></circle>
    <path d="M12 2.5v2M12 19.5v2M4.6 4.6 6 6M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4"></path>
  </svg>
</button>

<script>
  const root = document.documentElement;
  const isDark = () =>
    root.dataset.theme
      ? root.dataset.theme === 'dark'
      : matchMedia('(prefers-color-scheme: dark)').matches;

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
    const sync = () =>
      button.setAttribute('aria-label', `Switch to ${isDark() ? 'light' : 'dark'} theme`);
    sync();
    button.addEventListener('click', () => {
      const next = isDark() ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {
        // Storage blocked: the choice lasts for this page view only.
      }
      sync();
    });
  }
</script>
