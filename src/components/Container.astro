---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'div'> & { width?: 'prose' | 'wide' };
const { width = 'wide', class: className, ...rest } = Astro.props;
---

<div
  class:list={[
    'mx-auto w-full px-4 sm:px-6',
    width === 'prose' ? 'max-w-2xl' : 'max-w-6xl',
    className,
  ]}
  {...rest}
>
  <slot />
</div>
