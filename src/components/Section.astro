---
import Container from './Container.astro';

type Props = {
  id?: string;
  eyebrow?: string;
  title?: string;
  intro?: string;
  tone?: 'plain' | 'surface';
};
const { id, eyebrow, title, intro, tone = 'plain' } = Astro.props;
const headingId = id ? `${id}-title` : undefined;
---

<section
  id={id}
  aria-labelledby={title ? headingId : undefined}
  class:list={['py-16 sm:py-24', tone === 'surface' && 'bg-surface']}
>
  <Container>
    {title && (
      <header class="mb-10 max-w-2xl">
        {eyebrow && <p class="eyebrow mb-3">{eyebrow}</p>}
        <h2 id={headingId} class="text-h2">
          {title}
        </h2>
        {intro && <p class="mt-4 text-lead text-muted">{intro}</p>}
      </header>
    )}
    <slot />
  </Container>
</section>
