---
// Every page's search and social metadata. Used through Base.astro; data comes from profile.ts.
import { profile } from '../data/profile';
import {
  canonicalUrl,
  jsonLdGraph,
  ogImagePath,
  pageTitle,
  serializeJsonLd,
  SITE_URL,
} from '../lib/seo';

export type Props = {
  title: string;
  description: string;
  noindex?: boolean;
  /** Absolute or root-relative 1200×630 image. Defaults to the one generated for this path (see data/pages.ts). */
  image?: string;
  type?: 'website' | 'article' | 'profile';
  /** Page-specific JSON-LD nodes, added to the site-wide WebSite + Person graph. */
  jsonLd?: Record<string, unknown>[];
  /** Absolute URL this page's canonical should point to, e.g. where a post first ran. Defaults to this path. */
  canonical?: string;
};

const {
  title,
  description,
  noindex = false,
  image,
  type = 'website',
  jsonLd = [],
  canonical: canonicalOverride,
} = Astro.props;
const fullTitle = pageTitle(title);
const canonical = canonicalOverride ?? canonicalUrl(Astro.url.pathname);
// Resolved against this site, not the override: a cross-posted post's canonical is another domain.
const imageUrl = new URL(image ?? ogImagePath(Astro.url.pathname), SITE_URL).href;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link
  rel="alternate"
  type="application/rss+xml"
  title={`${profile.name} — Writing`}
  href={`${SITE_URL}/rss.xml`}
/>
{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={profile.name} />
<meta property="og:locale" content="en_IN" />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={fullTitle} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

<script type="application/ld+json" set:html={serializeJsonLd(jsonLdGraph(jsonLd))}></script>
