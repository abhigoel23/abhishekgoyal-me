---
// Home-page hero, left-aligned: positioning, intro, primary CTA, the intro-call link, credentials and the
// offline-first sync diagram. The photo is on /about (ADR 007).
import { bookCall } from '../data/lead';
import { primaryCta } from '../data/nav';
import { profile } from '../data/profile';
import Button from './Button.astro';
import SyncDiagram from './SyncDiagram.astro';

type Props = { headingLevel?: 'h1' | 'h2' };
const { headingLevel = 'h1' } = Astro.props;
const Heading = headingLevel;
---

<div class="grid items-center gap-12 md:grid-cols-[1.4fr_1fr] md:gap-16">
  <div>
    <p class="eyebrow mb-5">
      {profile.pillars.map((pillar, i) => (
        <>
          {i > 0 && ' · '}
          <span class="whitespace-nowrap">{pillar}</span>
        </>
      ))}
    </p>
    <Heading class="text-display text-ink">{profile.positioning}</Heading>
    <p class="mt-6 max-w-xl text-lead text-muted">{profile.intro}</p>
    <div class="mt-8 flex flex-wrap items-center gap-4">
      <Button href={primaryCta.href} size="lg" cta="hero_start_project">
        {primaryCta.label}
      </Button>
      <Button href={bookCall.href} variant="secondary" size="lg" cta="book_call">
        {bookCall.shortLabel} <span aria-hidden="true">↗</span>
      </Button>
    </div>
    <p class="mt-6 text-sm text-muted">{profile.credentials.join(' · ')}</p>
  </div>
  <SyncDiagram />
</div>
