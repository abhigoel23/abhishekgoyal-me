---
// Home-page hero: positioning, intro, primary CTA, the intro-call link, credentials and the photo. The photo sits on a
// surface-coloured box so it isn't an empty frame while it decodes.
import { Image } from 'astro:assets';
import photo from '../assets/profile/abhishek-goyal.jpg';
import { bookCall } from '../data/lead';
import { primaryCta } from '../data/nav';
import { profile } from '../data/profile';
import Button from './Button.astro';

type Props = { headingLevel?: 'h1' | 'h2' };
const { headingLevel = 'h1' } = Astro.props;
const Heading = headingLevel;
---

<div class="grid items-center gap-10 md:grid-cols-[1.5fr_1fr] md:gap-16">
  <div>
    <p class="eyebrow mb-5">
      {profile.pillars.map((pillar, i) => (
        <>
          {i > 0 && ' · '}
          <span class="whitespace-nowrap">{pillar}</span>
        </>
      ))}
    </p>
    <Heading class="text-display text-ink">{profile.positioning}</Heading>
    <p class="mt-6 max-w-xl text-lead text-muted">{profile.intro}</p>
    <div class="mt-8 flex flex-wrap items-center gap-4">
      <Button href={primaryCta.href} size="lg" cta="hero_start_project">
        {primaryCta.label}
      </Button>
      <Button href={bookCall.href} variant="secondary" size="lg" cta="book_call">
        {bookCall.shortLabel} <span aria-hidden="true">↗</span>
      </Button>
    </div>
    <p class="mt-6 text-sm text-muted">{profile.credentials.join(' · ')}</p>
  </div>
  <figure class="mx-auto w-full max-w-xs">
    <Image
      src={photo}
      alt={`${profile.name}, arms crossed, smiling at the camera`}
      widths={[320, 480, 640, 853]}
      sizes="(min-width: 768px) 320px, 80vw"
      loading="eager"
      fetchpriority="high"
      class="aspect-[4/5] w-full rounded-brand border border-line bg-surface object-cover object-top"
    />
    <figcaption class="mt-3 text-sm text-muted">
      {profile.name} · {profile.location.city}, {profile.location.country}
    </figcaption>
  </figure>
</div>
