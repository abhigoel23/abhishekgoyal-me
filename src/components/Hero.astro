---
// Home-page hero: positioning, intro, primary CTA, the employer link and the photo.
import { Image } from 'astro:assets';
import photo from '../assets/profile/abhishek-goyal.jpg';
import { hireCta, primaryCta } from '../data/nav';
import { profile } from '../data/profile';
import Button from './Button.astro';

type Props = { headingLevel?: 'h1' | 'h2' };
const { headingLevel = 'h1' } = Astro.props;
const Heading = headingLevel;
---

<div class="grid items-center gap-10 md:grid-cols-[1.5fr_1fr] md:gap-16">
  <div>
    <p class="eyebrow mb-5">
      {profile.pillars.map((pillar, i) => (
        <>
          {i > 0 && ' · '}
          <span class="whitespace-nowrap">{pillar}</span>
        </>
      ))}
    </p>
    <Heading class="text-display text-ink">{profile.positioning}</Heading>
    <p class="mt-6 max-w-xl text-lead text-muted">{profile.intro}</p>
    <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
      <Button href={primaryCta.href} size="lg" cta="hero_start_project">
        {primaryCta.label}
      </Button>
      <a href={hireCta.href} class="link text-sm font-medium" data-cta="hero_hire">
        {hireCta.label} →
      </a>
    </div>
  </div>
  <figure class="mx-auto w-full max-w-xs">
    <Image
      src={photo}
      alt={`${profile.name}, arms crossed, smiling at the camera`}
      widths={[320, 480, 640, 853]}
      sizes="(min-width: 768px) 320px, 80vw"
      loading="eager"
      fetchpriority="high"
      class="aspect-[4/5] w-full rounded-brand border border-line object-cover object-top"
    />
    <figcaption class="mt-3 text-sm text-muted">
      {profile.name} · {profile.location.city}, {profile.location.country}
    </figcaption>
  </figure>
</div>
