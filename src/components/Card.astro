---
import Tag from './Tag.astro';

type Props = {
  eyebrow?: string;
  title: string;
  summary: string;
  tags?: readonly string[];
  href?: string;
  /** Match the page outline: h2 when cards sit directly under the page h1. */
  headingLevel?: 'h2' | 'h3';
  /** Footer link text, shown only when `href` is set. */
  footerLabel?: string;
};
const {
  eyebrow,
  title,
  summary,
  tags = [],
  href,
  headingLevel = 'h3',
  footerLabel = 'Read the case study →',
} = Astro.props;
const Heading = headingLevel;
---

<article class="group relative flex h-full flex-col rounded-brand border border-line bg-bg p-6 transition-colors hover:border-ink/40">
  {eyebrow && <p class="eyebrow mb-4">{eyebrow}</p>}
  <Heading class="text-h3">
    {href ? (
      <a
        href={href}
        class="after:absolute after:inset-0 after:rounded-brand focus-visible:outline-none"
      >
        {title}
      </a>
    ) : (
      title
    )}
  </Heading>
  <p class="mt-3 text-muted">{summary}</p>
  {tags.length > 0 && (
    <ul class="mt-auto flex flex-wrap gap-2 pt-6" aria-label="Stack">
      {tags.map((tag) => (
        <li>
          <Tag>{tag}</Tag>
        </li>
      ))}
    </ul>
  )}
  {href && (
    <span aria-hidden="true" class="mt-5 text-sm font-medium text-accent">
      {footerLabel}
    </span>
  )}
</article>

<style>
  article:has(a:focus-visible) {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }
</style>
