---
type Props = { tone?: 'plain' | 'accent' };
const { tone = 'plain' } = Astro.props;
---

<span
  class:list={[
    'inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-medium',
    tone === 'accent' ? 'border-accent/40 text-accent' : 'border-line text-muted',
  ]}
>
  <slot />
</span>
