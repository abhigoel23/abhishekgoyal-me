---
// Row of headline numbers: the home page's profile stats, or a case study's `outcomes`.
import { profile } from '../data/profile';

type Props = { stats?: readonly { value: string; label: string }[] };
const { stats = profile.stats } = Astro.props;
---

<dl
  class:list={[
    'grid gap-8 border-y border-line py-8',
    stats.length === 4 ? 'grid-cols-2 lg:grid-cols-4' : 'sm:grid-cols-3',
  ]}
>
  {stats.map((stat) => (
    <div class="flex flex-col-reverse justify-end gap-1">
      <dt class="text-sm text-muted">{stat.label}</dt>
      <dd class="font-display text-h1">{stat.value}</dd>
    </div>
  ))}
</dl>
