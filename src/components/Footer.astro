---
import { consentCopy } from '../data/analytics';
import { profile } from '../data/profile';
import Container from './Container.astro';

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line py-12 text-sm text-muted">
  <Container class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="font-display text-lg text-ink">{profile.name}</p>
      <p class="mt-1">
        {profile.jobTitle} · {profile.location.city}, {profile.location.country}
      </p>
      <p class="mt-3">
        <a class="link" href={`mailto:${profile.email}`}>
          {profile.email}
        </a>
      </p>
    </div>
    <ul class="flex gap-5">
      <li>
        <a class="hover:text-ink" href={profile.links.github}>
          GitHub
        </a>
      </li>
      <li>
        <a class="hover:text-ink" href={profile.links.linkedin}>
          LinkedIn
        </a>
      </li>
      <li>
        <a class="hover:text-ink" href={profile.links.helperbook}>
          HelperBook
        </a>
      </li>
    </ul>
    <p>
      © {year} {profile.name} ·{' '}
      <a class="hover:text-ink" href="/privacy">
        Privacy
      </a>{' '}
      ·{' '}
      <button type="button" class="cursor-pointer hover:text-ink" data-consent-open>
        {consentCopy.settings}
      </button>
    </p>
  </Container>
</footer>
