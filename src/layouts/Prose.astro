---
// Layout for MDX pages (e.g. src/pages/privacy.mdx). Frontmatter `path` picks the SEO entry in data/pages.ts.
import Container from '../components/Container.astro';
import { pages, type PagePath } from '../data/pages';
import Base from './Base.astro';

type Props = { frontmatter: { path: PagePath; eyebrow?: string; updated?: string } };
const { path, eyebrow, updated } = Astro.props.frontmatter;
const page = pages[path];
---

<Base {...page}>
  <Container width="prose" class="py-16 sm:py-24">
    {eyebrow && <p class="eyebrow mb-3">{eyebrow}</p>}
    <h1 class="text-h1">{page.title}</h1>
    {updated && <p class="mt-3 text-sm text-muted">Last updated {updated}</p>}
    <article class="prose mt-10">
      <slot />
    </article>
  </Container>
</Base>
