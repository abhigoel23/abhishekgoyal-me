---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import Attribution from '../components/Attribution.astro';
import ConsentBar from '../components/ConsentBar.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SEO, { type Props as SeoProps } from '../components/SEO.astro';
import WebAnalytics from '../components/WebAnalytics.astro';
import { dark, fonts, light, themeCss } from '../lib/theme';

type Props = SeoProps & {
  /** Hide the footer's link to /checklist (on /checklist itself). */
  hideChecklistBand?: boolean;
};

const { hideChecklistBand, ...seo } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEO {...seo} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content={light.bg} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={dark.bg} media="(prefers-color-scheme: dark)" />
    <script is:inline>
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {
        // Storage blocked: fall back to the OS preference.
      }
    </script>
    <style is:global set:html={themeCss()}></style>
    <Attribution />
    <Analytics />
    <WebAnalytics />
    <Font cssVariable={fonts.display} preload />
    <Font cssVariable={fonts.body} preload />
    <Font cssVariable={fonts.mono} />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only z-50 rounded-brand bg-accent px-4 py-2 text-on-accent focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      Skip to content
    </a>
    <ConsentBar />
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer hideChecklistBand={hideChecklistBand} />
  </body>
</html>
