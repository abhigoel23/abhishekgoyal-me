{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "abhishekgoyal-me",
  // Wraps the Astro handler and adds the queue consumer and cron (src/worker.ts). The ASSETS binding is
  // filled in by @astrojs/cloudflare.
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Off for production: a version preview would run with production bindings. PR previews use staging.
  "preview_urls": false,
  "workers_dev": true,
  "vars": {
    "ENVIRONMENT": "production",
    // GA4 web stream measurement ID, public. Production sends to the live Measurement Protocol endpoint.
    "GA_MEASUREMENT_ID": "G-PHG39RRGSZ",
    // Production Sheet ("abhishekgoyal.me leads"), shared as Editor with its own service account only,
    // so the staging key can't reach it.
    "SHEET_ID": "1kajbfdXYs5Kwi9eCw_Cs6-DcLNdOgzh9l6sH2EifdkA",
    "GOOGLE_SA_EMAIL": "leads-writer-prod@abhishekgoyal-me.iam.gserviceaccount.com",
    // Where emailed links point: the confirmation link must reach this environment's D1.
    "SITE_ORIGIN": "https://abhishekgoyal.me",
    // Resend segment for newsletter subscribers (#110). An id, not a secret. Set at the M5 gate (#114);
    // until then the audience step fails and retries, which can't happen before sign-up is linked.
    "RESEND_SEGMENT_ID": "",
  },
  // /api/lead returns 503 until TURNSTILE_SECRET is set, so these bindings can go live before the
  // delivery secrets do. TURNSTILE_SECRET is loaded last (docs/RUNBOOK.md).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "abhishekgoyal-me",
      "database_id": "e0ede87b-510f-4670-b64a-e24807859c7a",
      "migrations_dir": "migrations",
    },
  ],
  "queues": {
    "producers": [{ "binding": "LEAD_QUEUE", "queue": "leads" }],
    "consumers": [
      {
        "queue": "leads",
        "max_batch_size": 10,
        "max_retries": 5,
        "retry_delay": 60,
        "dead_letter_queue": "leads-dlq",
      },
      // Dead letters alert and are dropped; D1 keeps the lead for the daily re-sync.
      { "queue": "leads-dlq", "max_batch_size": 10 },
    ],
  },
  // Per-IP limit for /api/lead. namespace_id is unique per account (staging uses 1001).
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
  ],
  // Daily at 03:30 UTC (09:00 IST): health check, outbox re-sync, retention purge.
  "triggers": { "crons": ["30 3 * * *"] },

  // The environment is picked at BUILD time: `CLOUDFLARE_ENV=staging pnpm build`. Bindings are not
  // inherited from the top level, so every binding is listed here. PR previews upload to this Worker
  // (abhishekgoyal-me-staging) so they never touch production data (ADR 006).
  "env": {
    "staging": {
      // PR previews are version preview URLs on this Worker (deploy-preview in ci.yml).
      "preview_urls": true,
      "vars": {
        "ENVIRONMENT": "staging",
        // Test Sheet ("abhishekgoyal.me leads (test)"), shared with the service account as Editor.
        "SHEET_ID": "18UYVwKcH5pJlZY5orlg8_U7PjwmS0fUK_drr_rIAEaI",
        "GOOGLE_SA_EMAIL": "leads-writer@abhishekgoyal-me.iam.gserviceaccount.com",
        // GA4 web stream measurement ID ("G-…"), public. Staging validates against GA's debug endpoint.
        "GA_MEASUREMENT_ID": "G-PHG39RRGSZ",
        // Where emailed links point (the confirmation link must reach this environment's D1).
        "SITE_ORIGIN": "https://abhishekgoyal-me-staging.abhigoel23.workers.dev",
        // Resend segment "Newsletter (staging)" (#110). An id, not a secret.
        "RESEND_SEGMENT_ID": "",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "abhishekgoyal-me-staging",
          "database_id": "9952fa1d-bbc8-4dc6-8de1-68e944471541",
          "migrations_dir": "migrations",
        },
      ],
      "queues": {
        "producers": [{ "binding": "LEAD_QUEUE", "queue": "leads-staging" }],
        "consumers": [
          {
            "queue": "leads-staging",
            "max_batch_size": 10,
            "max_retries": 5,
            "retry_delay": 60,
            "dead_letter_queue": "leads-staging-dlq",
          },
          // Dead letters alert and are dropped; D1 keeps the lead for the daily re-sync.
          { "queue": "leads-staging-dlq", "max_batch_size": 10 },
        ],
      },
      // Per-IP limit for /api/lead. Periods can only be 10 or 60 seconds; namespace_id is unique per account.
      "ratelimits": [
        { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
      ],
      // Daily at 03:30 UTC (09:00 IST): health check, outbox re-sync, retention purge.
      "triggers": { "crons": ["30 3 * * *"] },
    },
  },
}
