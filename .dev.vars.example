# Copy to .dev.vars (git-ignored) for local development. `pnpm cf:types` reads THIS file to type the
# Worker's secrets, so add every new secret here (with a safe local value) when you introduce it.
# Staging and production values are set with `wrangler secret put NAME --env staging` (production in M4).
ENVIRONMENT=local

# Turnstile (#56). Cloudflare's public test secret: always passes. Real keys: Cloudflare dashboard →
# Turnstile → add widget. Staging keeps the test secret; production gets its own in M4.
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# Google Sheets (#58). The service account's private key (the "private_key" field of its JSON key file).
# SHEET_ID and GOOGLE_SA_EMAIL are plain vars in wrangler.jsonc. Leave empty locally unless you're
# testing Sheets delivery; the queue then marks the sheets step failed and retries.
GOOGLE_SA_KEY=

# Resend (#59): an API key with "Sending access" restricted to abhishekgoyal.me (resend.com → API Keys).
# Outside production, auto-replies go to the inbox instead of the visitor.
RESEND_API_KEY=
# Telegram (#59): bot token from @BotFather, and the chat id of your chat with the bot. Staging messages
# are prefixed [staging].
# Resend contacts (#110): a FULL-access key, used only to add confirmed subscribers to the segment
# (a sending key can't manage contacts), and the webhook signing secret ("whsec_…") from Resend →
# Webhooks, for unsubscribes. The segment id is a plain var in wrangler.jsonc.
RESEND_CONTACTS_KEY=
# Local/e2e only: a dummy secret so tests/lead can sign webhook events. Staging and production get the
# real one from Resend.
RESEND_WEBHOOK_SECRET=whsec_bG9jYWwtZTJlLXdlYmhvb2stc2VjcmV0
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Cal.com (#60): the webhook signing secret (`openssl rand -hex 32`), also pasted into Cal.com →
# Settings → Developer → Webhooks for the /api/booking subscriber.
CAL_WEBHOOK_SECRET=

# GA4 (#62). GA_MEASUREMENT_ID ("G-…") is public and lives in wrangler.jsonc vars; the Measurement
# Protocol secret is GA4 → Admin → Data streams → (stream) → Measurement Protocol API secrets.
# Outside production the server uses GA's validation endpoint, so nothing is recorded.
GA_MP_API_SECRET=
